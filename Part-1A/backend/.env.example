MONGODB_URI=mongodb://127.0.0.1:27017/library?replicaSet=rs0
SESSION_SECRET=replace-with-a-long-random-secret
LIBRARY_TIME_ZONE=America/New_York
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
