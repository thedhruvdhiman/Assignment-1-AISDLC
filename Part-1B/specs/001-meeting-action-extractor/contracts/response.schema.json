{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SCH-1",
  "title": "Meeting Action Extractor Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actionItems",
    "keyDecisions",
    "summary",
    "clarificationQuestions"
  ],
  "properties": {
    "actionItems": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/actionItem"
      }
    },
    "keyDecisions": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/keyDecision"
      }
    },
    "summary": {
      "type": "string"
    },
    "clarificationQuestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clarificationQuestion"
      }
    }
  },
  "$defs": {
    "sourceQuote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "actionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "assignee",
        "deadline",
        "source_quote",
        "needs_clarification"
      ],
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "assignee": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_quote": {
          "$ref": "#/$defs/sourceQuote"
        },
        "needs_clarification": {
          "type": "boolean"
        }
      }
    },
    "keyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "source_quote",
        "needs_clarification"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "source_quote": {
          "$ref": "#/$defs/sourceQuote"
        },
        "needs_clarification": {
          "type": "boolean"
        }
      }
    },
    "clarificationQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "about",
        "itemIndex"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "about": {
          "enum": [
            "actionItem",
            "decision",
            "transcript",
            "other"
          ]
        },
        "itemIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
